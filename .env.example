# MAIAMARI.STUDIO — Ortam değişkenleri
# Bu dosyayı `.env.local` olarak kopyalayıp değerleri doldur.
# .env.local git'e GİRMEZ (.gitignore'da .env* var).

# --- Veritabanı (Supabase Postgres) ---
# Supabase paneli → Project Settings → Database → Connection string → "Transaction pooler"
# (port 6543). <PASSWORD> kısmını proje şifrenle değiştir.
DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres"

# --- Görsel yükleme (Supabase Storage) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<PROJECT_REF>.supabase.co"
# service_role anahtarı SADECE server tarafında kullanılır, asla client'a sızmaz.
SUPABASE_SERVICE_ROLE_KEY="<SERVICE_ROLE_KEY>"
SUPABASE_STORAGE_BUCKET="product-images"

# --- Admin paneli girişi ---
# Güçlü bir şifre belirle; ADMIN_SESSION_SECRET için rastgele uzun bir dize üret.
ADMIN_PASSWORD="<güçlü-bir-şifre>"
ADMIN_SESSION_SECRET="<rastgele-uzun-dize-en-az-32-karakter>"

# --- iyzico (Faz 4 — şimdilik boş bırakılabilir) ---
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# --- Sipariş bildirimi e-postası (Resend) ---
# resend.com'da ücretsiz hesap aç, API Keys'ten bir anahtar oluştur.
# ORDER_EMAIL_FROM: test için onboarding@resend.dev (yalnız hesap e-postana
# gönderir). Prod'da maiamari.art'ı Resend'de doğrulayıp
# "Maiamari <siparis@maiamari.art>" yap. Müşteriye onay maili için
# ORDER_EMAIL_CUSTOMER="1" (doğrulanmış alan gerekir). Anahtar yoksa bildirim
# sessizce atlanır; sipariş akışı etkilenmez.
RESEND_API_KEY=""
ORDER_EMAIL_FROM="Maiamari <onboarding@resend.dev>"
ORDER_EMAIL_TO="maiamariart@gmail.com"
ORDER_EMAIL_CUSTOMER="0"

# Maildeki "Panelde aç" linkinin tabanı. LOKAL testte http://localhost:3000 yap;
# prod'da (Vercel) boş bırak → varsayılan https://www.maiamari.art.
SITE_URL=""

# Checkout (sepet + kendi ödeme akışı) canlıda açık mı. iyzico GERÇEK ödeme hazır
# olana kadar PROD'da KONMAZ (kapalı → müşteri mock test ödemesine ulaşamaz,
# "Online ödeme yakında" görür). Lokal geliştirme + iyzico hazır olunca: 1.
NEXT_PUBLIC_CHECKOUT_ENABLED=""
